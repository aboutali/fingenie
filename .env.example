# Copy to .env and fill in the keys you have. All keys are optional.
# Sources without a key are skipped; keyless sources work without configuration.

# Tiingo: daily history (https://www.tiingo.com, free signup)
FINGENIE_TIINGO_KEY=

# Finnhub: real-time US quotes (https://finnhub.io, free signup)
FINGENIE_FINNHUB_KEY=

# Twelve Data: intraday multi-asset data (https://twelvedata.com, free signup)
FINGENIE_TWELVEDATA_KEY=

# Set to false to disable the local cache.
# FINGENIE_CACHE_ENABLED=true
